# ghcr.io 反向代理（Docker Registry pull-through proxy）
#
# 用途：让 Docker 通过本代理拉取 ghcr.io 镜像
#
#   原始：  ghcr.io/jcleng/opencode-free-provider:latest
#   代理：  134.175.61.80:5999/jcleng/opencode-free-provider:latest
#
# ---------------------------------------------------------------------------
# 关于证书：使用 Caddy 内置的 ACME 客户端自动申请【公网可信】证书
# ---------------------------------------------------------------------------
# 不需要自签证书，也不需要客户端安装 ca.crt —— 证书由 Let's Encrypt 签发，
# Docker 客户端开箱即信（和访问任何 https 网站一样）。
#
# 注意：对「裸 IP」签发证书是 Let's Encrypt 的新能力（2025 年起 GA），有两条硬性要求：
#   1) 必须使用 `shortlived` profile（证书有效期约 6 天，Caddy 会自动续期）；
#   2) 只能用 http-01 或 tls-alpn-01 验证，即服务器的 **80 或 443 端口必须对公网开放**。
#      （不能用 DNS 验证来证明你拥有一个 IP）
# 因此本容器需要同时暴露 80/443 用于 ACME 验证，5999 用于镜像拉取。
#
# 如果你有域名，直接指向本机即可，改用 90 天证书、且无上述限制：
#   把下面的 tls { ... } 整块删掉，并把站点地址换成域名（见 README「附录 B」）。
#
# 关键点：ghcr.io 返回 401 时带有
#         WWW-Authenticate: Bearer realm="https://ghcr.io/token",...
#         若不改写，客户端会直接访问 https://ghcr.io/token（绕过代理）。
#         因此把 realm 重写为本代理地址，让 token 请求也走代理。

{
	# ACME 账户邮箱（Let's Encrypt 用于到期提醒/找回账户）
	email {$ACME_EMAIL:j.c.leng@foxmail.com}

	# ACME 服务器。调试时可改为 Let's Encrypt staging 以免触发速率限制：
	#   -e ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

(ghcr_proxy) {
	# 1) token 端点：原样转发到 ghcr.io（ghcr.io 的 token 端点会忽略 service 参数，
	#    因此即使客户端传 service=<本代理地址> 也能正常签发 token）
	handle /token* {
		reverse_proxy https://ghcr.io {
			header_up Host ghcr.io
		}
	}

	# 2) 其余全部按 Docker Registry v2 协议转发到 ghcr.io
	handle {
		reverse_proxy https://ghcr.io {
			header_up Host ghcr.io
			# 把上游认证 realm 改写为本代理，保证 token 请求不绕过代理。
			# 用 {http.request.scheme} + {http.request.hostport} 同时兼容 HTTP/HTTPS 与端口
			# （{http.request.host} 会丢端口，导致 401）
			header_down WWW-Authenticate "https://ghcr.io/token" "{http.request.scheme}://{http.request.hostport}/token"
		}
	}

	log {
		output stdout
		format console
	}
}

# 站点地址：默认裸 IP + 5999 端口，可用 SITE_ADDR 覆盖
#   -e SITE_ADDR=134.175.61.80:5999
# 若改成域名（如 ghcr.example.com），请同时删掉下面的 tls 块。
{$SITE_ADDR:134.175.61.80:5999} {
	tls {
		issuer acme {
			# 裸 IP 证书被 Let's Encrypt 强制要求使用 shortlived profile
			profile {$ACME_PROFILE:shortlived}
		}
	}
	import ghcr_proxy
}
